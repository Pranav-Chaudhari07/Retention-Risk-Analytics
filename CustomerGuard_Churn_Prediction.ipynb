   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Step 4 — Data Ingestion & Validation"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "MANDATORY_COLUMNS = ['customerID','tenure','MonthlyCharges','TotalCharges','Churn']\n",
    "\n",
    "df_raw = pd.read_csv(CSV_PATH)\n",
    "print(f'Loaded: {df_raw.shape[0]} rows × {df_raw.shape[1]} columns')\n",
    "\n",
    "# Schema validation\n",
    "missing_cols = [c for c in MANDATORY_COLUMNS if c not in df_raw.columns]\n",
    "if missing_cols:\n",
    "    raise ValueError(f'Missing mandatory columns: {missing_cols}')\n",
    "print('✅  Schema valid.')\n",
    "df_raw.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## Step 5 — Preprocessing (Imputation, Encoding, Scaling)"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = df_raw.copy()\n",
    "\n",
    "# ── 5a. Coerce TotalCharges to numeric ──────────────────────────────\n",
    "df['TotalCharges'] = pd.to_numeric(df['TotalCharges'], errors='coerce')\n",
    "\n",
    "# ── 5b. Drop customerID (identifier, not a feature) ─────────────────\n",
    "df.drop(columns=['customerID'], inplace=True)\n",
    "\n",
    "# ── 5c. Impute numerical columns (median) ───────────────────────────\n",
    "NUMERICAL_COLS = ['tenure', 'MonthlyCharges', 'TotalCharges']\n",
    "for col in NUMERICAL_COLS:\n",
    "    n_missing = df[col].isnull().sum()\n",
    "    if n_missing > 0:\n",
    "        median_val = df[col].median()\n",
    "        df[col].fillna(median_val, inplace=True)\n",
    "        print(f'Imputed {n_missing} missing value(s) in \"{col}\" with median={median_val:.2f}')\n",
    "\n",
    "# ── 5d. Impute categorical columns (mode) ───────────────────────────\n",
    "CATEGORICAL_COLS = df.select_dtypes(include='object').columns.tolist()\n",
    "for col in CATEGORICAL_COLS:\n",
    "    n_missing = df[col].isnull().sum()\n",
    "    if n_missing > 0:\n",
    "        mode_val = df[col].mode()[0]\n",
    "        df[col].fillna(mode_val, inplace=True)\n",
    "        print(f'Imputed {n_missing} missing value(s) in \"{col}\" with mode={mode_val}')\n",
    "\n",
    "# ── 5e. Encode target ───────────────────────────────────────────────\n",
    "df['Churn'] = (df['Churn'].str.strip().str.lower() == 'yes').astype(int)\n",
    "\n",
    "# ── 5f. Encode binary categorical columns ───────────────────────────\n",
    "BINARY_COLS = ['gender','Partner','Dependents','PhoneService','PaperlessBilling']\n",
    "binary_encoders = {}\n",
    "for col in BINARY_COLS:\n",
    "    le = LabelEncoder()\n",
    "    df[col] = le.fit_transform(df[col].astype(str))\n",
    "    binary_encoders[col] = le\n",
    "\n",
    "# ── 5g. One-Hot encode multi-class columns (drop-first) ─────────────\n",
    "MULTICLASS_COLS = ['MultipleLines','InternetService','OnlineSecurity','OnlineBackup',\n",
    "                   'DeviceProtection','TechSupport','StreamingTV','StreamingMovies',\n",
    "                   'Contract','PaymentMethod']\n",
    "df = pd.get_dummies(df, columns=MULTICLASS_COLS, drop_first=True)\n",
    "\n",
    "print(f'\\n✅  Preprocessing done. Feature matrix shape: {df.shape}')\n",
    "df.head()"
   ]
  },
